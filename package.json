{
        "name": "satimetta.org",
        "author": "Doron Tal",
        "private": false,
        "version": "1.1.27",
        "type": "module",
        "imports": {
                "#lib/*": "./src/lib/*"
        },
        "prepare": "svelte-kit sync",
        "scripts": {
                "dev": "vite dev",
                "build": "vite build",
                "preview": "vite preview",
                "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
                "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
                "format": "prettier --write .",
                "lint": "prettier --check . && eslint .",
                "test:e2e": "playwright test",
                "test": "npm run test:e2e && npm run test:unit -- --run",
                "test:unit": "vitest",
                "deploy": "npx gh-pages -d build --dotfiles"
        },
        "devDependencies": {
                "@eslint/compat": "^2.1.1",
                "@lucide/svelte": "^1.78.0",
                "@playwright/test": "^1.65.1",
                "@skeletonlabs/skeleton": "^5.0.6",
                "@skeletonlabs/skeleton-svelte": "^5.0.6",
                "@sveltejs/adapter-static": "^4.0.1",
                "@sveltejs/kit": "^3.4.0",
                "@sveltejs/vite-plugin-svelte": "^7.3.1",
                "@tailwindcss/postcss": "^4.3.5",
                "eslint": "^10.15.0",
                "eslint-config-prettier": "^10.1.8",
                "eslint-plugin-svelte": "^3.24.1",
                "gh-pages": "^6.3.0",
                "globals": "^17.14.0",
                "postcss": "^8.5.33",
                "prettier": "^3.10.1",
                "prettier-plugin-svelte": "^4.2.0",
                "prettier-plugin-tailwindcss": "^0.8.1",
                "svelte": "^5.59.1",
                "svelte-check": "^4.7.8",
                "tailwindcss": "^4.3.5",
                "typescript": "~6.0.0",
                "typescript-eslint": "^8.73.0",
                "vite": "^8.3.8",
                "vitest": "^5.1.1"
        }
}
